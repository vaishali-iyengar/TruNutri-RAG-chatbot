# Copy to .env and fill in. .env is gitignored.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Paths (defaults are relative to the project root)
# CORPUS_DIR=corpus
# REGISTRY_PATH=corpus/registry.yaml

# Index: local Qdrant storage path, or set QDRANT_URL to use a server
# INDEX_PATH=.index
# QDRANT_URL=http://localhost:6333
# COLLECTION_NAME=guidance_chunks

# Models
# EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
# Groq models; both support strict structured outputs (guaranteed-valid JSON)
# GENERATOR_MODEL=openai/gpt-oss-120b
# EVIDENCE_CHECK_MODEL=openai/gpt-oss-20b

# Answer threshold on rerank scores (calibrated in Phase 7.5).
# The retrieval sizes and tau_doc are in RetrievalConfig (src/guidance_rag/config.py).
# TAU_ANSWER=0.27

# Groq quotas, enforced client-side per model (free tier for openai/gpt-oss-120b).
# Tokens per minute count the prompt plus max_completion_tokens; usage is logged in
# .cache/llm/usage.sqlite so separate runs share the daily budget.
# GROQ_RPM=30
# GROQ_RPD=1000
# GROQ_TPM=8000
# GROQ_TPD=200000

# Scope guard (Phase 5): optional LLM classifier (on Groq) after the rules. It can only add
# refusals the rules missed; each one is logged to logs/scope_classifier.jsonl.
# On by default; set to false to use the rules alone.
# SCOPE_CLASSIFIER=true
# SCOPE_CLASSIFIER_MODEL=openai/gpt-oss-20b

# API limits (Phase 9.5): total seconds per /chat request, and /chat requests per client
# IP per minute.
# CHAT_TIMEOUT_S=60
# CHAT_RATE_PER_MINUTE=20
